# Google OAuth client ID (Web application). Empty = name-only dev login.
GOOGLE_CLIENT_ID=
# "localhost" locally; on the home server: yourname.duckdns.org (ports 80/443 forwarded).
SITE_ADDRESS=localhost
# DuckDNS updater (only used with: docker compose --profile duckdns up -d)
# DUCKDNS_SUBDOMAIN is just "yourname", without .duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
